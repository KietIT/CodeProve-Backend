{
  "code": "CP-104",
  "reference_solution": [
    "from queue import Queue",
    "from threading import Thread",
    "",
    "def run_pipeline(items, worker, n_consumers=2, maxsize=4):",
    "    q = Queue(maxsize=maxsize)",
    "    results = [None] * len(items)",
    "",
    "    def consume():",
    "        while True:",
    "            job = q.get()",
    "            if job is None:",
    "                break",
    "            i, item = job",
    "            results[i] = worker(item)",
    "",
    "    threads = [Thread(target=consume) for _ in range(n_consumers)]",
    "    for t in threads:",
    "        t.start()",
    "    for i, item in enumerate(items):",
    "        q.put((i, item))",
    "    for _ in threads:",
    "        q.put(None)",
    "    for t in threads:",
    "        t.join()",
    "    return results"
  ],
  "tests": [
