{
  "code": "CP-207",
  "reference_solution": [
    "from types import SimpleNamespace",
    "",
    "def serialize(root):",
    "    out = []",
    "",
    "    def dfs(node):",
    "        if not node:",
    "            out.append(\"#\")",
    "            return",
    "        out.append(str(node.val))",
    "        dfs(node.left)",
    "        dfs(node.right)",
    "",
    "    dfs(root)",
    "    return \",\".join(out)",
    "",
    "def deserialize(data):",
    "    vals = iter(data.split(\",\"))",
    "",
    "    def build():",
    "        v = next(vals)",
    "        if v == \"#\":",
    "            return None",
    "        return SimpleNamespace(val=int(v), left=build(), right=build())",
    "",
    "    return build()"
  ],
  "tests": [
    {
      "description": "test_empty_tree",
      "input": "serialize(None)",
      "expected": "'#'",
      "category": "boundary",
      "hidden": false
    },
    {
      "description": "test_three_node_tree",
      "input": "(lambda NS: serialize(NS(1, NS(2), NS(3))))(lambda v, l=None, r=None: __import__('types').SimpleNamespace(val=v, left=l, right=r))",
      "expected": "'1,2,#,#,3,#,#'",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "round trip of a full tree",
      "input": "serialize(deserialize(serialize(__import__('types').SimpleNamespace(val=1, left=__import__('types').SimpleNamespace(val=2, left=__import__('types').SimpleNamespace(val=4, left=None, right=None), right=__import__('types').SimpleNamespace(val=5, left=None, right=None)), right=__import__('types').SimpleNamespace(val=3, left=__import__('types').SimpleNamespace(val=6, left=None, right=None), right=__import__('types').SimpleNamespace(val=7, left=None, right=None))))))",
      "expected": "'1,2,4,#,#,5,#,#,3,6,#,#,7,#,#'",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "deserialize rebuilds the structure",
      "input": "(lambda t: (t.val, t.left.val, t.right.val, t.left.left))(deserialize('1,2,#,#,3,#,#'))",
      "expected": "(1, 2, 3, None)",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "empty tree round trip",
      "input": "deserialize(serialize(None))",
      "expected": "None",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "single node",
      "input": "(lambda t: (t.val, t.left, t.right))(deserialize(serialize(__import__('types').SimpleNamespace(val=9, left=None, right=None))))",
      "expected": "(9, None, None)",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "left-leaning tree keeps its shape",
      "input": "serialize(deserialize(serialize(__import__('types').SimpleNamespace(val=1, left=__import__('types').SimpleNamespace(val=2, left=__import__('types').SimpleNamespace(val=3, left=None, right=None), right=None), right=None))))",
      "expected": "'1,2,3,#,#,#,#'",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "right-leaning tree keeps its shape",
      "input": "serialize(deserialize(serialize(__import__('types').SimpleNamespace(val=1, left=None, right=__import__('types').SimpleNamespace(val=2, left=None, right=__import__('types').SimpleNamespace(val=3, left=None, right=None))))))",
      "expected": "'1,#,2,#,3,#,#'",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "negative and multi-digit values",
      "input": "(lambda t: (t.val, t.left.val))(deserialize(serialize(__import__('types').SimpleNamespace(val=-12, left=__import__('types').SimpleNamespace(val=345, left=None, right=None), right=None))))",
      "expected": "(-12, 345)",
      "category": "edge",
      "hidden": true
    }
  ],
