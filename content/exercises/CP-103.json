{
  "code": "CP-103",
  "reference_solution": [
    "import jwt",
    "",
    "def verify_token(token, secret):",
    "    try:",
    "        return jwt.decode(token, secret, algorithms=[\"HS256\"])",
    "    except jwt.InvalidTokenError:",
    "        return None"
  ],
  "tests": [
    {
      "description": "test_malformed_token_returns_none",
      "input": "verify_token('not.a.valid.token', 'secret')",
      "expected": "None",
      "category": "edge",
      "hidden": false
    },
    {
      "description": "test_wrong_secret_returns_none",
      "input": "verify_token(__import__('jwt').encode({'sub': '1'}, 'wrong', algorithm='HS256'), 'right')",
      "expected": "None",
      "category": "edge",
      "hidden": false
    },
    {
      "description": "valid token returns its claims",
      "input": "sorted(verify_token(__import__('jwt').encode({'sub': '1', 'exp': int(__import__('time').time()) + 3600}, 'k', algorithm='HS256'), 'k').items())[1]",
      "expected": "('sub', '1')",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "token that has not expired yet",
      "input": "verify_token(__import__('jwt').encode({'sub': '7', 'exp': int(__import__('time').time()) + 3600}, 'k', algorithm='HS256'), 'k')['sub']",
      "expected": "'7'",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "expired token is rejected",
      "input": "verify_token(__import__('jwt').encode({'sub': '1', 'exp': int(__import__('time').time()) - 60}, 'k', algorithm='HS256'), 'k')",
      "expected": "None",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "unsigned 'none' algorithm is rejected",
      "input": "verify_token(__import__('jwt').encode({'sub': 'admin'}, None, algorithm='none'), 'k')",
      "expected": "None",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "tampered payload is rejected",
      "input": "(lambda p: verify_token(p[0] + '.' + __import__('jwt').encode({'sub': 'admin'}, 'k', algorithm='HS256').split('.')[1] + '.' + p[2], 'k'))(__import__('jwt').encode({'sub': '1'}, 'k', algorithm='HS256').split('.'))",
      "expected": "None",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "empty token",
      "input": "verify_token('', 'k')",
      "expected": "None",
      "category": "boundary",
      "hidden": true
    }
  ],
