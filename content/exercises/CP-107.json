{
  "code": "CP-107",
  "reference_solution": [
    "def has_cycle(graph):",
    "    state = {}  # 0 = visiting, 1 = done",
    "",
    "    def dfs(node):",
    "        if state.get(node) == 0:",
    "            return True",
    "        if state.get(node) == 1:",
    "            return False",
    "        state[node] = 0",
    "        if any(dfs(n) for n in graph[node]):",
    "            return True",
    "        state[node] = 1",
    "        return False",
    "",
    "    return any(dfs(n) for n in graph)"
  ],
  "tests": [
    {
      "description": "test_acyclic_graph",
      "input": "has_cycle({0: [1], 1: [2], 2: []})",
      "expected": "False",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "test_cycle_graph",
      "input": "has_cycle({0: [1], 1: [2], 2: [0]})",
      "expected": "True",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "diamond is not a cycle",
      "input": "has_cycle({0: [1, 2], 1: [3], 2: [3], 3: []})",
      "expected": "False",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "self loop",
      "input": "has_cycle({0: [0]})",
      "expected": "True",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "cycle in a second component",
      "input": "has_cycle({0: [1], 1: [], 2: [3], 3: [2]})",
      "expected": "True",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "empty graph",
      "input": "has_cycle({})",
      "expected": "False",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "single node without edges",
      "input": "has_cycle({0: []})",
      "expected": "False",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "long chain",
      "input": "has_cycle({i: [i + 1] for i in range(150)} | {150: []})",
      "expected": "False",
      "category": "boundary",
      "hidden": true
    }
