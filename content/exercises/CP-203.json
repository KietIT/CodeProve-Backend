{
  "code": "CP-203",
  "reference_solution": [
    "VALID_TOKENS = {\"valid-token\"}",
    "",
    "def deny():",
    "    return \"401 Unauthorized\"",
    "",
    "def verify(token):",
    "    return token in VALID_TOKENS",
    "",
    "def require_auth(request, handler):",
    "    token = request.headers.get(\"Authorization\")",
    "    if token and verify(token):",
    "        return handler(request)",
    "    return deny()"
  ],
  "tests": [
    {
      "description": "test_valid_token_runs_handler",
      "input": "require_auth(type('Req', (), {'headers': {'Authorization': 'valid-token'}})(),lambda req: 'OK')",
      "expected": "'OK'",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "test_forged_token_rejected",
      "input": "require_auth(type('Req', (), {'headers': {'Authorization': 'forged'}})(),lambda req: 'HANDLER_RAN') != 'HANDLER_RAN'",
      "expected": "True",
      "category": "edge",
      "hidden": false
    },
    {
      "description": "forged token gets the deny response",
      "input": "require_auth(type('Req', (), {'headers': {'Authorization': 'forged'}})(), lambda req: 'OK')",
      "expected": "'401 Unauthorized'",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "the handler never runs for a forged token",
      "input": "(lambda calls: (require_auth(type('Req', (), {'headers': {'Authorization': 'nope'}})(), lambda req: calls.append(1)), len(calls))[-1])([])",
      "expected": "0",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "missing header is denied",
      "input": "require_auth(type('Req', (), {'headers': {}})(), lambda req: 'OK')",
      "expected": "'401 Unauthorized'",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "empty token is denied",
      "input": "require_auth(type('Req', (), {'headers': {'Authorization': ''}})(), lambda req: 'OK')",
      "expected": "'401 Unauthorized'",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "the handler receives the request",
      "input": "require_auth(type('Req', (), {'headers': {'Authorization': 'valid-token'}})(), lambda req: req.headers['Authorization'])",
      "expected": "'valid-token'",
      "category": "happy",
      "hidden": true
    }
  ],
