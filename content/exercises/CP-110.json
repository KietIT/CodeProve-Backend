{
  "code": "CP-110",
  "reference_solution": [
    "from collections import deque",
    "",
    "def max_sliding_window(nums, k):",
    "    dq, out = deque(), []",
    "    for i, n in enumerate(nums):",
    "        while dq and nums[dq[-1]] < n:",
    "            dq.pop()",
    "        dq.append(i)",
    "        if dq[0] <= i - k:",
    "            dq.popleft()",
    "        if i >= k - 1:",
    "            out.append(nums[dq[0]])",
    "    return out"
  ],
