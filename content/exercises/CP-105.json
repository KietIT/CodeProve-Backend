{
  "code": "CP-105",
  "reference_solution": [
    "def length_of_longest(s):",
    "    seen = {}",
    "    start = best = 0",
    "    for i, c in enumerate(s):",
    "        if c in seen and seen[c] >= start:",
    "            start = seen[c] + 1",
    "        seen[c] = i",
    "        best = max(best, i - start + 1)",
    "    return best"
  ],
  "tests": [
    {
      "description": "test_basic_abcabc",
      "input": "length_of_longest('abcabcbb')",
      "expected": "3",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "test_all_same",
      "input": "length_of_longest('bbbbb')",
      "expected": "1",
      "category": "happy",
      "hidden": false
