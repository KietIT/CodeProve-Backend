{
  "code": "CP-009",
  "reference_solution": [
    "def is_allowed(client_id, store, limit=60):",
    "    count = store.get(client_id, 0)",
    "    if count >= limit:",
    "        return False",
    "    store[client_id] = count + 1",
    "    return True"
  ],
  "tests": [
    {
      "description": "test_under_limit",
      "input": "is_allowed('user1', {}, limit=60)",
      "expected": "True",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "test_at_limit_blocked",
      "input": "is_allowed('user1', {'user1': 60}, limit=60)",
      "expected": "False",
      "category": "boundary",
      "hidden": false
    },
    {
      "description": "third request over a limit of two",
      "input": "(lambda s: [is_allowed('a', s, limit=2) for _ in range(3)])({})",
      "expected": "[True, True, False]",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "the store counts each allowed request",
      "input": "(lambda s: (is_allowed('a', s, limit=5), s)[1])({})",
      "expected": "{'a': 1}",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "clients are limited independently",
      "input": "(lambda s: [is_allowed('a', s, limit=1), is_allowed('b', s, limit=1), is_allowed('a', s, limit=1)])({})",
      "expected": "[True, True, False]",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "limit of zero blocks everything",
      "input": "is_allowed('a', {}, limit=0)",
      "expected": "False",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "limit of one",
      "input": "(lambda s: [is_allowed('x', s, limit=1) for _ in range(2)])({})",
      "expected": "[True, False]",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "default limit is 60",
      "input": "(lambda s: sum(is_allowed('a', s) for _ in range(61)))({})",
      "expected": "60",
      "category": "boundary",
      "hidden": true
    }
  ],
