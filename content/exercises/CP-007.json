{
  "code": "CP-007",
  "reference_solution": [
    "def merge(a, b):",
    "    i = j = 0",
    "    out = []",
    "    while i < len(a) and j < len(b):",
    "        if a[i] <= b[j]:",
    "            out.append(a[i]); i += 1",
    "        else:",
    "            out.append(b[j]); j += 1",
    "    return out + a[i:] + b[j:]"
  ],
  "tests": [
    {
      "description": "test_interleaved",
      "input": "merge([1, 3, 5], [2, 4, 6])",
      "expected": "[1, 2, 3, 4, 5, 6]",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "test_non_overlapping",
      "input": "merge([1, 2], [3, 4])",
      "expected": "[1, 2, 3, 4]",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "second array first",
      "input": "merge([4, 5, 6], [1, 2, 3])",
      "expected": "[1, 2, 3, 4, 5, 6]",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "repeated values",
      "input": "merge([1, 1, 2], [1, 3])",
      "expected": "[1, 1, 1, 2, 3]",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "negative numbers",
      "input": "merge([-5, 0, 5], [-3, 3])",
      "expected": "[-5, -3, 0, 3, 5]",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "both empty",
      "input": "merge([], [])",
      "expected": "[]",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "first empty",
      "input": "merge([], [1, 2])",
      "expected": "[1, 2]",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "second empty",
      "input": "merge([1, 2], [])",
      "expected": "[1, 2]",
      "category": "boundary",
      "hidden": true
    }
  ],
