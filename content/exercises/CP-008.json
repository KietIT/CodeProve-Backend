{
  "code": "CP-008",
  "reference_solution": [
    "def display_name(user):",
    "    profile = user.get(\"profile\") or {}",
    "    return profile.get(\"name\", \"Unknown\")"
  ],
  "tests": [
    {
      "description": "test_has_profile",
      "input": "display_name({'profile': {'name': 'Alice'}})",
      "expected": "'Alice'",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "test_missing_profile_returns_unknown",
      "input": "display_name({})",
      "expected": "'Unknown'",
      "category": "boundary",
      "hidden": false
    },
    {
      "description": "another name",
      "input": "display_name({'profile': {'name': 'Bob'}, 'id': 7})",
      "expected": "'Bob'",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "non-ASCII name",
      "input": "display_name({'profile': {'name': 'Zoë'}})",
      "expected": "'Zoë'",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "profile without a name",
      "input": "display_name({'profile': {}})",
      "expected": "'Unknown'",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "profile is None",
      "input": "display_name({'profile': None})",
      "expected": "'Unknown'",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "name outside the profile does not count",
      "input": "display_name({'name': 'Eve'})",
      "expected": "'Unknown'",
      "category": "edge",
      "hidden": true
    }
  ],
