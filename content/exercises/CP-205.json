{
  "code": "CP-205",
  "reference_solution": [
    "def is_match(s, p):",
    "    memo = {}",
    "",
    "    def dp(i, j):",
    "        if (i, j) in memo:",
    "            return memo[(i, j)]",
    "        if j == len(p):",
    "            ans = i == len(s)",
    "        else:",
    "            first = i < len(s) and p[j] in (s[i], \".\")",
    "            if j + 1 < len(p) and p[j + 1] == \"*\":",
    "                ans = dp(i, j + 2) or (first and dp(i + 1, j))",
    "            else:",
    "                ans = first and dp(i + 1, j + 1)",
    "        memo[(i, j)] = ans",
    "        return ans",
    "",
    "    return dp(0, 0)"
  ],
  "tests": [
    {
      "description": "test_star_matches_multiple",
      "input": "is_match('aa', 'a*')",
      "expected": "True",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "test_dot_star_matches_any",
      "input": "is_match('ab', '.*')",
      "expected": "True",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "dot matches exactly one character",
      "input": "is_match('abc', 'a.c')",
      "expected": "True",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "star can match zero characters",
      "input": "is_match('aab', 'c*a*b')",
