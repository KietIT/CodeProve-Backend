{
  "code": "CP-001",
  "reference_solution": [
    "def two_sum(nums, target):",
    "    seen = {}",
    "    for i, n in enumerate(nums):",
    "        if target - n in seen:",
    "            return [seen[target - n], i]",
    "        seen[n] = i",
    "    return []"
  ],
  "tests": [
    {
      "description": "test_basic_case",
      "input": "two_sum([2, 7, 11, 15], 9)",
      "expected": "[0, 1]",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "test_duplicates",
      "input": "two_sum([3, 3], 6)",
      "expected": "[0, 1]",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "an element cannot pair with itself",
      "input": "two_sum([3, 2, 4], 6)",
      "expected": "[1, 2]",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "negative numbers",
      "input": "two_sum([-3, 4, 3, 90], 0)",
      "expected": "[0, 2]",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "zero target with repeated zeros",
      "input": "two_sum([0, 4, 3, 0], 0)",
      "expected": "[0, 3]",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "smallest input",
      "input": "two_sum([1, 9], 10)",
      "expected": "[0, 1]",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "pair at the very end",
      "input": "two_sum([1, 2, 3, 4], 7)",
      "expected": "[2, 3]",
      "category": "boundary",
      "hidden": true
    },
    {
      "description": "long input, pair at the end",
      "input": "two_sum(list(range(2000)), 3997)",
      "expected": "[1998, 1999]",
      "category": "boundary",
      "hidden": true
    }
  ],
