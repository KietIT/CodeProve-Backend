{
  "code": "CP-102",
  "reference_solution": [
    "from collections import OrderedDict",
    "",
    "_cache = OrderedDict()",
    "MAX_ENTRIES = 128",
    "",
    "def memoize(key, compute):",
    "    if key in _cache:",
    "        _cache.move_to_end(key)",
    "        return _cache[key]",
    "    _cache[key] = compute()",
    "    if len(_cache) > MAX_ENTRIES:",
    "        _cache.popitem(last=False)",
    "    return _cache[key]"
  ],
  "tests": [
    {
      "description": "test_caches_result",
      "input": "memoize('answer', lambda: 42)",
      "expected": "42",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "test_returns_cached_not_recomputed",
      "input": "(memoize('x', lambda: 10), memoize('x', lambda: 99))[1]",
      "expected": "10",
      "category": "happy",
      "hidden": false
    },
    {
      "description": "computes once per key",
      "input": "(lambda n: (memoize('k1', lambda: n.append(1) or 'v'), memoize('k1', lambda: n.append(1) or 'v'), len(n))[-1])([])",
      "expected": "1",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "different keys keep their own values",
      "input": "(memoize('a1', lambda: 1), memoize('b1', lambda: 2), memoize('a1', lambda: 3))",
      "expected": "(1, 2, 1)",
      "category": "happy",
      "hidden": true
    },
    {
      "description": "a falsy result is still cached",
      "input": "(lambda n: (memoize('z', lambda: n.append(1) or 0), memoize('z', lambda: n.append(1) or 0), len(n))[-1])([])",
      "expected": "1",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "the cache stays bounded",
      "input": "([memoize(('many', i), lambda i=i: i) for i in range(5000)], len(_cache) < 5000)[-1]",
      "expected": "True",
      "category": "edge",
      "hidden": true
    },
    {
      "description": "still returns the right value after many keys",
      "input": "([memoize(('more', i), lambda i=i: i) for i in range(3000)], memoize(('more', 2999), lambda: -1))[-1]",
      "expected": "2999",
      "category": "boundary",
      "hidden": true
    }
  ],
