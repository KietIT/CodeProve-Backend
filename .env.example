# Postgres credentials used by docker-compose (db service + backend URL).
# Use a long random password; URL-encode it in DATABASE_URL if it has special chars.
POSTGRES_USER=codeprove
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Optional: URL-encoded copy of POSTGRES_PASSWORD when it contains @ / ? # % :
# Keep POSTGRES_PASSWORD unchanged for Postgres itself; Compose uses this value in DATABASE_URL.
# Example: a password ending in @ needs %40 at the end here.
POSTGRES_PASSWORD_URLENCODED=
POSTGRES_DB=codeprove
# Used by tools run from .venv on the host (compose overrides it for the backend).
DATABASE_URL=postgresql+asyncpg://codeprove:change-me-to-a-long-random-password@localhost:5432/codeprove
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:3000
# The frontend's same-origin admin gateway works with lax; direct cross-site
# callers need HTTPS and none.
ADMIN_COOKIE_SAMESITE=lax
SANDBOX_TIMEOUT=5
# Max sandbox executions (trace + run) per user per minute.
SANDBOX_RATE_LIMIT_PER_MINUTE=20
# Scoring engine for new reports: v1 (default) or v2 (rubric levels, P1.4).
# Switch to v2 only after it passes the golden-set check (P1.4 plan, Task 7).
SCORING_ENGINE=v1
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
ADMIN_API_KEY=
# Daily DB backups to S3 (scripts/backup_db.sh; see docs/RUNBOOK.md). The EC2
# instance role supplies AWS credentials - never put access keys here.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=postgres
BACKUP_AWS_REGION=
# Optional dead-man's-switch URL (e.g. healthchecks.io): pinged on success,
# "<url>/fail" on failure, and alerts if no ping arrives on schedule.
BACKUP_HEALTHCHECK_URL=
# SePay payments (my.sepay.vn). Never commit real values.
# SEPAY_API_KEY: any long random string; type the same value into SePay's webhook form (auth type "API Key").
SEPAY_API_KEY=
# The bank account linked in SePay that receives the money, and its bank's short name (e.g. TPBank).
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NAME=
# Transfer content = this prefix + order id. Set the same payment-code prefix in SePay's settings.
SEPAY_CODE_PREFIX=CP
# Google Analytics 4: the server reports paid orders as `purchase` (docs/analytics/ga4.md). Empty = off.
# GA_MEASUREMENT_ID is the web stream's "G-..." id (same as the frontend's NEXT_PUBLIC_GA_ID).
# GA_API_SECRET: GA4 Admin > Data streams > CodeProve Web > Measurement Protocol API secrets. Never commit it.
GA_MEASUREMENT_ID=
GA_API_SECRET=

# Host port the local Postgres container is published on (change if 5432 is taken)
DB_HOST_PORT=5432
# Plan limits (defaults shown). Free: CIEL_PER_DAY and FREE_SUBMITS_PER_MONTH; paid plans below.
# CIEL_PER_DAY=20
# CIEL_PER_DAY_PLUS=100
# CIEL_PER_DAY_PRO=200
# FREE_SUBMITS_PER_MONTH=10
